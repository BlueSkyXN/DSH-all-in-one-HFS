# Deployment-control template. Store real values in
# local/hfs-targets/production.env, not in a root .env file: dsh treats DSH_*
# and network bootstrap variables as inherited-environment-only inputs.

# Required login for the public application endpoint.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Canonical public authority accepted by the upstream browser trust fence.
DSH_TRUSTED_HOST=blueskyxn-dsh-all-in-one-hfs.hf.space

# Optional inference provider setting. This should be a Space Secret.
DEEPSEEK_API_KEY=

# Local deployment control only; never synchronized into the Space runtime.
HF_TOKEN=
GH_TOKEN=
